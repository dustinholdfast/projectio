// Prisma schema for the Task Board app.
// Docs: https://pris.ly/d/prisma-schema
//
// Domain: a single-user-per-board Kanban board, backed by Postgres (Supabase in
// hosted environments, a local container in development). A User owns Boards; each
// Board has ordered Columns; each Column has ordered Cards. Ordering is a
// persisted `position` Float per sibling set — a card/column dropped between
// two neighbors gets the midpoint of their positions, so a reorder only writes
// the moved row (see the "Persist reorder" card). Larger position = later.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An application user. Authentication is credential-based (Auth.js credentials
/// provider, wired in a later card): `email` is the login identifier and
/// `passwordHash` holds a bcrypt hash — never a plaintext password.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Boards this user owns and boards shared with them are deliberately
  /// separate: Board.ownerId is canonical ownership; BoardMember grants access.
  boards              Board[]
  memberships         BoardMember[]
  passwordResetTokens PasswordResetToken[]
}

/// A single-use, expiring credential for the "forgot password" flow.
///
/// Only the SHA-256 *hash* of the token is stored: the raw value exists in the
/// email link and nowhere else, so a leaked database dump cannot be used to
/// reset anyone's password. Rows are kept after use (`usedAt`) rather than
/// deleted so a replayed link can be told apart from an unknown one.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Issuing a new token invalidates the account's outstanding ones.
  @@index([userId])
}

/// One recorded authentication attempt, used for rate limiting (see
/// `lib/rate-limit.ts`). Rows are transient: they are counted within a sliding
/// window and pruned once they fall outside it, so this table stays small.
///
/// Deliberately not related to `User` — attempts are recorded for addresses that
/// may not exist, and must survive an account being deleted.
model AuthAttempt {
  id        String   @id @default(cuid())
  /// Namespaced bucket, e.g. `login:ip:1.2.3.4` or `login:email:a@b.com`.
  key       String
  createdAt DateTime @default(now())

  // Every query counts recent rows for one key, so both columns are needed.
  @@index([key, createdAt])
}

/// A Kanban board owned by a single User. Deleting the owner cascades to their
/// boards (and, transitively, columns and cards).
/// What a member may do on a board.
///
/// Ordered least to most privileged; `lib/authz.ts` compares them by rank rather
/// than by listing roles at each call site, so adding a role later does not mean
/// auditing every check.
enum BoardRole {
  VIEWER
  EDITOR
  OWNER
}

model Board {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  columns    Column[]
  members    BoardMember[]
  shareLinks BoardShareLink[]

  @@index([ownerId])
}

/// Who may touch a board, and how.
///
/// Owners do not also receive a membership row. `Board.ownerId` is the sole
/// source of truth for ownership; this table contains VIEWER and EDITOR grants.
/// The migration enforces that distinction with a CHECK constraint because
/// Prisma does not currently express CHECK constraints in this schema.
model BoardMember {
  boardId   String
  userId    String
  role      BoardRole
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  // "Which boards can this user see" is the board-list query, and runs on every
  // page load.
  @@index([userId])
}

/// A capability URL granting access to a board at a fixed role.
///
/// Only a SHA-256 hash is stored. The raw URL is returned once at creation; the
/// owner can later identify the link by a short non-secret prefix, revoke it, or
/// create a replacement.
///
/// A link grants EDITOR or VIEWER only, expires, and remains individually
/// revocable without exposing a reusable credential in a database backup.
model BoardShareLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  tokenPrefix String
  boardId   String
  /// The role granted on joining. OWNER is rejected in the action layer.
  role      BoardRole
  expiresAt DateTime
  /// Set when the link is turned off. Revoking does NOT remove people who
  /// already joined — they are members in their own right by then, and the
  /// members list is where you remove them.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

/// A vertical lane on a board (e.g. "To Do", "In Progress", "Done").
/// `position` orders columns left-to-right within their board.
model Column {
  id        String   @id @default(cuid())
  name      String
  position  Float
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  // Ordered lookups of a board's columns hit (boardId, position) together.
  @@index([boardId, position])
}

/// A task card within a column. `position` orders cards top-to-bottom within
/// their column; a move to another column updates `columnId` and `position`.
/// Triage weight. Deliberately nullable rather than defaulting to MEDIUM: "nobody
/// has decided yet" is real information, and a default would erase it by making
/// every new card look triaged.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Card {
  id          String   @id @default(cuid())
  title       String
  /// Short summary, shown on the card face. Long-form detail belongs in `notes`.
  description String?
  position    Float
  columnId    String

  // ── Detail fields (edited in the card dialog) ─────────────────────────────
  /// Legacy free-text responsibility label, not a User relation. Proper member
  /// assignment is a later collaboration feature and should use a dedicated
  /// relation rather than silently changing the meaning of this field.
  owner       String?
  /// Long-form detail. Unlike `description` this never renders on the card face,
  /// so it can run to any length without making the board unscannable.
  notes       String?
  /// Free text rather than a lookup table: categories differ per board and per
  /// person, and a fixed list would be wrong for everyone. The dialog offers
  /// existing values on the board as suggestions.
  category    String?
  priority    Priority?
  /// Date-only, for the same reason as dueDate: these are days, not instants.
  startedAt   DateTime? @db.Date
  /// Set = the card is done. Takes precedence over every other schedule state
  /// (see lib/due-status.ts) — finished work must not keep reporting as overdue.
  completedAt DateTime? @db.Date
  /// Calendar day the card is due, stored date-only (`@db.Date`) because a due
  /// date is a day, not an instant — storing a timestamp would make the same
  /// card read as due on different days in different timezones. Null = unscheduled.
  dueDate     DateTime? @db.Date
  /// When the card was paused. Null = not paused. A timestamp rather than a
  /// boolean so "how long has this been parked?" stays answerable. Paused wins
  /// over any due date when deriving status (see lib/due-status.ts).
  pausedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  checklist ChecklistItem[]
  /// Cards this one waits on.
  blockedBy CardBlock[] @relation("BlockedCard")
  /// Cards waiting on this one.
  blocking  CardBlock[] @relation("BlockerCard")

  // Ordered lookups of a column's cards hit (columnId, position) together.
  @@index([columnId, position])
}

/// A tick-box sub-item on a card. Ordered with the same `position` Float scheme
/// as columns and cards, so the midpoint insert logic in lib/reorder.ts applies
/// unchanged.
model ChecklistItem {
  id        String   @id @default(cuid())
  cardId    String
  text      String
  done      Boolean  @default(false)
  position  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
}

/// "`blocked` cannot proceed until `blocker` is done."
///
/// An explicit join table rather than an implicit many-to-many, because the two
/// sides mean different things and the naming has to say which is which — an
/// implicit relation would give an opaque `_CardToCard` table.
///
/// Both sides cascade: deleting either card removes the link rather than leaving
/// a dangling dependency. Cycles and cross-board links are rejected in the
/// action layer (see lib/actions/card-details.ts), not here — Postgres has no
/// native way to express "no cycles in this graph".
model CardBlock {
  blockedId String
  blockerId String
  createdAt DateTime @default(now())

  blocked Card @relation("BlockedCard", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker Card @relation("BlockerCard", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockedId, blockerId])
  @@index([blockerId])
}
