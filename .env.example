# Copy to `.env` and fill in. Prisma loads this via prisma.config.ts; Next.js
# loads it for the app at runtime. Never commit the real `.env`.

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Runtime connection, used by the driver adapter in lib/prisma.ts.
# Supabase: use a POOLED string from Dashboard -> Connect.
#   - Serverless (Vercel):        transaction pooler, port 6543
#   - Long-running server:        session pooler,     port 5432
# Append ?sslmode=require for Supabase.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/taskboard_dev"

# Migration connection, used only by the Prisma CLI (prisma.config.ts).
# Must be a DIRECT (non-transaction-pooled) connection — DDL and the migration
# advisory lock need a real session. If your host has no IPv6 outbound, use
# Supabase's session pooler string here instead of the direct one.
# Optional locally: falls back to DATABASE_URL when unset.
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Max connections per pool, per app instance. The number that matters is
# (instances x this) against your pooler's ceiling. 1-2 on serverless, ~5 on a
# long-running server. Defaults to 5.
# DB_POOL_MAX=5

# Throwaway database for the Playwright suite. `npm run test:e2e` DROPS EVERY
# TABLE here via `prisma migrate reset` — never point it at dev or production.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/taskboard_test"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs/encrypts the session JWT. Required in every environment. Rotating it
# signs everyone out. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required on hosts that terminate TLS upstream (Render, Railway, Fly, nginx,
# Caddy) so Auth.js trusts the forwarded host header. Not needed on Vercel.
# AUTH_TRUST_HOST=true

# ── Email ───────────────────────────────────────────────────────────────────
# Password-reset links are built from the request headers by default, which is
# right on every supported host. Set this only when the public URL differs from
# what the proxy forwards.
# APP_URL="https://board.example.com"

# No email provider is wired up: reset links are written to the server log (see
# lib/mailer.ts, which documents how to add one). Configure a real provider
# before relying on account recovery in production.

# Test-only seam: when set, the console mailer also appends each message to this
# file as JSON lines, which is how the e2e suite reads the link it was sent.
# Set by playwright.config.ts; leave unset otherwise.
# MAIL_OUTBOX_PATH=".mail-outbox.jsonl"
